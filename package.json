{
  "name": "recording-transcript-player",
  "version": "1.0.0",
  "description": "Obsidian plugin for synchronized audio and SRT transcript playback.",
  "main": "main.js",
  "scripts": {
    "dev": "node esbuild.config.mjs",
    "build": "tsc -noEmit -skipLibCheck && node esbuild.config.mjs production",
    "test": "tsx --test tests/**/*.test.ts",
    "version": "node version-bump.mjs && git add manifest.json versions.json",
    "release": "npm run build"
  },
  "keywords": [
    "obsidian",
    "plugin",
    "transcript",
    "srt",
    "audio"
  ],
  "author": "Evgeniy Branitsky",
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^20.11.30",
    "builtin-modules": "^3.3.0",
    "esbuild": "^0.25.0",
    "obsidian": "^1.8.7",
    "tsx": "^4.7.1",
    "typescript": "^5.4.3"
  }
}
